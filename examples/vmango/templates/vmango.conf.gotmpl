# Lifecycle demonstration: no clouds, users, hypervisors, or image downloads.
log_level = {{ printf "%q" .vmango.log_level }}
key_file = "/var/lib/vmango/authorized_keys"
api {
    listen = {{ printf "%q" .vmango.listen }}
    jwt_signing_key_file = "/var/lib/vmango/jwt_signing_key"
    console_signing_key_file = "/var/lib/vmango/console_signing_key"
    session_dir = "/var/lib/vmango/sessions"
    token_dir = "/var/lib/vmango/tokens"
}
tasks {
    directory = "/var/lib/vmango/tasks"
    workers = 2
    retention_days = 0
}
